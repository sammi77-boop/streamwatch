# Copy to .env on the server and fill in. Never commit or share .env.
DISCORD_TOKEN=
# Right-click your server icon > Copy Server ID (needs Developer Mode on)
GUILD_ID=
# Right-click your own name > Copy User ID
OWNER_ID=
YOUTUBE_API_KEY=
# The one Google calendar stream events go to (calendar settings > "Calendar ID").
# Share that calendar with the service account email ("Make changes to events").
# The service account key goes next to this file as google_service_account.json.
GOOGLE_CALENDAR_ID=
# Schedule images are read by Gemini on Google Cloud, using the service account key above
# (its project needs the Agent Platform API and the Vertex AI User role).
# Optional fallback: IMAGE_READER=claude with an Anthropic API key.
# IMAGE_READER=gemini
# ANTHROPIC_API_KEY=
# Your timezone, for dropdown labels and timezone-less schedules in review
OWNER_TZ=America/Los_Angeles
